<Window x:Class="Kursovay.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kursovay.Views"
        mc:Ignorable="d"
        Title="Панель Администратора" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Выйти" Click="BtnLogout_Click" 
            Padding="10,5" Margin="0,0,20,0" Background="LightCoral" 
            FontWeight="Bold" Cursor="Hand" ToolTip="Вернуться на окно авторизации"/>
            <TextBlock Text="Поиск по ФИО:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>

            <TextBox x:Name="TxtSearch" Width="250" Padding="5" TextChanged="TxtSearch_TextChanged" 
             VerticalContentAlignment="Center"/>

            <Button Content="Стереть" Click="BtnClearSearch_Click" Margin="5,0,20,0" Padding="5" 
            ToolTip="Очистить поиск" Background="LightGray" Cursor="Hand"/>

            <Button Content="Сформировать отчет" Click="BtnGenerateReport_Click" 
            Padding="15,5" Background="LightYellow" Cursor="Hand"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <GroupBox Header="Новый ученик" Padding="10" FontWeight="Bold">
                    <StackPanel>
                        <TextBlock Text="ФИО:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtFullName" Margin="0,5,0,10" Padding="5"/>

                        <TextBlock Text="Телефон:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtPhone" Margin="0,5,0,10" Padding="5"/>

                        <TextBlock Text="Группа:" FontWeight="Normal"/>
                        <ComboBox x:Name="CmbGroup" DisplayMemberPath="GroupNumber" Margin="0,5,0,15" Padding="5"/>

                        <Button Content="Зачислить ученика" Click="BtnAddStudent_Click" 
                                Height="35" Background="#c5e2c1" Cursor="Hand"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Смена статуса" Padding="10" Margin="0,15,0,0" FontWeight="Bold">
                    <StackPanel>
                        <TextBlock Text="Выберите ученика в таблице справа:" FontWeight="Normal" Foreground="Gray" Margin="0,0,0,10"/>
                        <Button Content="Обучается" Click="BtnSetEnrolled_Click" Margin="0,0,0,5" Padding="5" Cursor="Hand"/>
                        <Button Content="Выпустить" Click="BtnSetGraduated_Click" Margin="0,0,0,5" Padding="5" Cursor="Hand"/>
                        <Button Content="Отчислить" Click="BtnSetExpelled_Click" Padding="5" Background="MistyRose" Cursor="Hand"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <DataGrid x:Name="GridStudents" Grid.Column="1" AutoGenerateColumns="False" 
                      IsReadOnly="True" AlternatingRowBackground="WhiteSmoke" RowHeight="25">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupNumber}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
